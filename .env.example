# SALONIX Environment Configuration Example
# Copy to .env and fill in your local or production values. Never commit real secrets.

# Server port
PORT=3000

# Required JWT signing secret (use a long random string)
JWT_SECRET="replace-with-strong-random-jwt-secret"

# Database Engine Selection:
#   postgres -> PostgreSQL / Google Cloud SQL (default when SQL_HOST is set for Postgres)
#   mysql    -> MariaDB / MySQL (XAMPP / phpMyAdmin local development)
DB_DRIVER="postgres"

# Database Connection Settings
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_USER="postgres"
SQL_PASSWORD=""
SQL_DATABASE="salonix"

# Example for local XAMPP / phpMyAdmin (MariaDB):
# DB_DRIVER="mysql"
# SQL_HOST="localhost"
# SQL_PORT="3306"
# SQL_USER="root"
# SQL_PASSWORD=""
# SQL_DATABASE="salonix"
