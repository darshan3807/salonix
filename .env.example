# ==============================================================================
# SALONIX Environment Configuration Example
# Copy this file to .env and fill in your local or production values.
# NEVER commit your real .env file or expose database credentials in frontend code.
# ==============================================================================

# Server Port
PORT=3000

# Required JWT Signing Secret (replace with a long random string)
JWT_SECRET="replace-with-strong-random-jwt-secret"
JWT_EXPIRES_IN="7d"

# ==============================================================================
# PRIMARY LOCAL CONFIGURATION: XAMPP MySQL / MariaDB + phpMyAdmin
# ==============================================================================
# Accepted DB_DRIVER values:
#   mysql    -> MySQL / MariaDB via mysql2 (XAMPP / phpMyAdmin)
#   mariadb  -> Alias for mysql (uses mysql2)
#   postgres -> PostgreSQL via pg (Google Cloud SQL / local PostgreSQL)
DB_DRIVER="mysql"
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="salonix_db"
DB_USER="root"
DB_PASSWORD="your-xampp-mysql-password-or-leave-empty-if-none"

# ==============================================================================
# ALTERNATIVE CONFIGURATION: PostgreSQL / Google Cloud SQL
# ==============================================================================
# DB_DRIVER="postgres"
# DB_HOST="127.0.0.1"
# DB_PORT="5432"
# DB_NAME="salonix"
# DB_USER="postgres"
# DB_PASSWORD="your-postgres-password"
